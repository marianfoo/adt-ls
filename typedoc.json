{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "hideGenerator": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "entryFileName": "README.md",
  "sort": ["source-order"],
  "gitRevision": "main"
}
